# Copy this to .env.local (already .gitignore'd) and fill in real values.
#
# Security model
# --------------
# Every DB read/write goes through server code (Route Handlers, Server
# Actions, Server Components). The browser NEVER talks to Supabase
# directly — it only talks to Next.js API routes. So the browser bundle
# needs zero DB credentials.
#
# Rules:
#   • NEXT_PUBLIC_* is embedded into the browser bundle. Only use for
#     values that are safe to be public (the project URL is fine).
#   • SUPABASE_SERVICE_KEY is the service_role secret from Supabase
#     Dashboard → Settings → API. It bypasses RLS. NEVER prefix it
#     with NEXT_PUBLIC_ — that would leak it to every browser.
#   • Tables have RLS enabled with zero policies (deny-all for anon).
#     service_role bypasses RLS, so server code works; anyone who
#     scrapes the anon key from an old cache still gets denied.

# The Supabase project URL. Safe to expose (it's just a hostname).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role secret. REQUIRED — the app will refuse to boot
# without it. Copy from Dashboard → Settings → API → service_role.
# Treat this like a database password.
SUPABASE_SERVICE_KEY=sb_secret_service_role_key_here

# The anon (publishable) key. No longer used by the app at runtime,
# but kept in .env.example for reference — you may still want it for
# ad-hoc curl scripts against the REST API, or if you ever add a
# public-facing endpoint that needs RLS-gated access.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_jwt_key_here

# Dhan static app-level token for pulling fund holdings. Only needed by
# the /api/sync-fund-holdings route.
DHAN_TOKEN_ID=

# ── Studio page test mode ────────────────────────────────────────────
# The /studio page is the daily "recording stage" — it lands on an
# order-entry form and, on submit, plays a fireworks + reveal
# animation for the video. While this flag is TRUE:
#   • Every submit from the Studio form is tagged platform='test'
#   • logMfTransaction SKIPS the fund_holdings bump AND the
#     recomputeNwDaily() call for those rows, so the MF card, XIRR,
#     growth chart, and net-worth numbers stay untouched
#   • A yellow "TEST MODE" banner is rendered at the top of /studio
#     so nobody wonders whether a run was real or rehearsal
#   • Rows still land in mf_transactions for inspection — clean up
#     any time with:  DELETE FROM mf_transactions WHERE platform='test'
# Flip to false when you've tested the flow enough and want submits
# to write real trades. The submitted `platform` value then becomes
# whatever the form's platform dropdown says (INDmoney by default).
# NEXT_PUBLIC_ prefix required because the flag is read by the
# client-side Studio component to know whether to render the banner.
NEXT_PUBLIC_FUNDS_TEST_MODE=true

# ── Auth gate (middleware.ts) ────────────────────────────────────────
# Vayu ships with a single-user login gate in front of every route.
# All three env vars below are REQUIRED — middleware fails closed on
# missing APP_SESSION_SECRET, and the login action rejects logins
# with missing APP_USERNAME or APP_PASSWORD.
#
# On Vercel: set all three in Project → Settings → Environment
# Variables BEFORE the first deploy.

# The username you'll type at /login. Case-insensitive, trimmed on
# both server and client. Any string works — the security benefit
# over "password-only" is essentially zero (an attacker just guesses
# one more field), but a username field lets your browser's password
# manager save the credential as a proper "vayu-username@your-domain"
# entry rather than a generic form autofill.
APP_USERNAME=vayu

# The password you'll type at /login. Pick something you don't reuse
# elsewhere. Rotating this only forces new logins for people who
# haven't logged in yet — existing sessions survive (they're bound
# to APP_SESSION_SECRET, not the password). To invalidate all
# sessions, rotate APP_SESSION_SECRET instead.
APP_PASSWORD=change-me

# 32+ bytes of randomness used as the HMAC-SHA256 key for signing
# session cookies. Anyone who has this can mint valid cookies without
# knowing the password — treat it like a database key. Never commit.
# Generate a fresh value with:  openssl rand -base64 32
APP_SESSION_SECRET=change-me-to-32-random-bytes-base64-encoded

